{
  "name": "@0xkahi/pi-qol",
  "version": "1.0.3",
  "description": "quality of life pi extensions",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "author": "0xKahi",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "assets/config.schema.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xKahi/pi-qol.git"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "biome": "biome check ./src",
    "lint": "bun biome",
    "lint:fix": "bun biome --write",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint:fix && bun run type-check",
    "release": "changeset publish",
    "version": "changeset version",
    "changeset": "changeset",
    "buildSchema": "bun run scripts/build-schema.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.0.0",
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@0xkahi/cli-dye": "^1.1.0",
    "zod": "^4.4.3"
  }
}
