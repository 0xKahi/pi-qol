{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/0xKahi/pi-qol/main/assets/config.schema.json",
  "title": "Pi Quality of Life Extensions Configuration",
  "description": "Configuration schema for pi-qol extension",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "auto_session_name": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "modelId": {
              "type": "string"
            },
            "reasoning": {
              "type": "string",
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "provider",
            "modelId",
            "reasoning"
          ]
        }
      }
    },
    "model_select": {
      "default": {
        "enabled": false,
        "favourite": [],
        "favourite_label": "Favourites",
        "groups": [],
        "hide_tabs": {
          "groups": false,
          "search": false
        },
        "provider_filter": [],
        "layout": "inline"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "favourite": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "modelId": {
                "type": "string"
              },
              "groups": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "provider",
              "modelId"
            ]
          }
        },
        "favourite_label": {
          "default": "Favourites",
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hide_tabs": {
          "default": {
            "groups": false,
            "search": false
          },
          "type": "object",
          "properties": {
            "groups": {
              "default": false,
              "type": "boolean"
            },
            "search": {
              "default": false,
              "type": "boolean"
            }
          }
        },
        "provider_filter": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default_reasoning": {
          "type": "string",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "layout": {
          "default": "inline",
          "type": "string",
          "enum": [
            "inline",
            "overlay"
          ]
        }
      }
    },
    "custom_footer": {
      "default": {
        "enabled": false,
        "colors": {
          "anthropicUsage": "#D97706",
          "codexUsage": "#10B981"
        },
        "icons": {
          "directory": " ",
          "refresh": "",
          "cache": " ",
          "cacheRead": " ",
          "cacheWrite": " "
        },
        "display": {
          "tokens": true,
          "cache": true,
          "agentName": false
        },
        "defaultAgentName": "DEFAULT"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "colors": {
          "default": {
            "anthropicUsage": "#D97706",
            "codexUsage": "#10B981"
          },
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "modelName": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "agentName": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "anthropicUsage": {
              "default": "#D97706",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "codexUsage": {
              "default": "#10B981",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "icons": {
          "default": {
            "directory": " ",
            "refresh": "",
            "cache": " ",
            "cacheRead": " ",
            "cacheWrite": " "
          },
          "type": "object",
          "properties": {
            "directory": {
              "default": " ",
              "type": "string"
            },
            "refresh": {
              "default": "",
              "type": "string"
            },
            "cache": {
              "default": " ",
              "type": "string"
            },
            "cacheRead": {
              "default": " ",
              "type": "string"
            },
            "cacheWrite": {
              "default": " ",
              "type": "string"
            }
          }
        },
        "display": {
          "default": {
            "tokens": true,
            "cache": true,
            "agentName": false
          },
          "type": "object",
          "properties": {
            "tokens": {
              "default": true,
              "type": "boolean"
            },
            "cache": {
              "default": true,
              "type": "boolean"
            },
            "agentName": {
              "default": false,
              "type": "boolean"
            }
          }
        },
        "defaultAgentName": {
          "default": "DEFAULT",
          "type": "string"
        }
      }
    },
    "context_view": {
      "default": {
        "enabled": false,
        "layout": "inline"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "layout": {
          "default": "inline",
          "type": "string",
          "enum": [
            "inline",
            "overlay"
          ]
        }
      }
    },
    "workmux": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      }
    }
  }
}