{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/0xKahi/pi-qol/main/assets/config.schema.json",
  "title": "Pi Btw Extension Configuration",
  "description": "Configuration schema for pi-qol extension",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "auto_session_name": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "modelId": {
              "type": "string"
            },
            "reasoning": {
              "type": "string",
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "provider",
            "modelId",
            "reasoning"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "auto_session_name"
  ],
  "additionalProperties": false
}