{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/0xKahi/pi-qol/main/assets/config.schema.json",
  "title": "Pi Quality of Life Extensions Configuration",
  "description": "Configuration schema for pi-qol extension",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "auto_session_name": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "modelId": {
              "type": "string"
            },
            "reasoning": {
              "type": "string",
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "provider",
            "modelId",
            "reasoning"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "model_select": {
      "default": {
        "enabled": false,
        "favourite": [],
        "provider_filter": [],
        "layout": "inline"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "favourite": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "modelId": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "modelId"
            ],
            "additionalProperties": false
          }
        },
        "provider_filter": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "layout": {
          "default": "inline",
          "type": "string",
          "enum": [
            "inline",
            "overlay"
          ]
        }
      },
      "required": [
        "enabled",
        "favourite",
        "provider_filter",
        "layout"
      ],
      "additionalProperties": false
    },
    "custom_footer": {
      "default": {
        "enabled": false,
        "colors": {
          "anthropicUsage": "#D97706",
          "codexUsage": "#10B981"
        },
        "icons": {
          "directory": " ",
          "refresh": "",
          "cache": " ",
          "cacheRead": " ",
          "cacheWrite": " "
        },
        "display": {
          "tokens": true,
          "cache": true
        }
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "colors": {
          "default": {
            "anthropicUsage": "#D97706",
            "codexUsage": "#10B981"
          },
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "modelName": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "anthropicUsage": {
              "default": "#D97706",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "codexUsage": {
              "default": "#10B981",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "anthropicUsage",
            "codexUsage"
          ],
          "additionalProperties": false
        },
        "icons": {
          "default": {
            "directory": " ",
            "refresh": "",
            "cache": " ",
            "cacheRead": " ",
            "cacheWrite": " "
          },
          "type": "object",
          "properties": {
            "directory": {
              "default": " ",
              "type": "string"
            },
            "refresh": {
              "default": "",
              "type": "string"
            },
            "cache": {
              "default": " ",
              "type": "string"
            },
            "cacheRead": {
              "default": " ",
              "type": "string"
            },
            "cacheWrite": {
              "default": " ",
              "type": "string"
            }
          },
          "required": [
            "directory",
            "refresh",
            "cache",
            "cacheRead",
            "cacheWrite"
          ],
          "additionalProperties": false
        },
        "display": {
          "default": {
            "tokens": true,
            "cache": true
          },
          "type": "object",
          "properties": {
            "tokens": {
              "default": true,
              "type": "boolean"
            },
            "cache": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "tokens",
            "cache"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "colors",
        "icons",
        "display"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "auto_session_name",
    "model_select",
    "custom_footer"
  ],
  "additionalProperties": false
}